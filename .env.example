NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
DEV_MANAGER_EMAIL=<your-google-email>
DEV_TRAINER_EMAIL=<optional-google-email-for-trainer-testing>
DEV_RIDER_EMAIL=<optional-google-email-for-rider-testing>
DEV_EMAIL=<your-google-email>         # used by seed-account.sh and change-user.sh
DEV_NAME=<your full name>             # split on first space for first/last name defaults
DEV_BARN=<barn-slug>                  # default barn slug for seed-account.sh
