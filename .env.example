NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
DEV_EMAIL=<your-google-email>         # used by change-user.sh — must match the Google account you claim the seed invite with
DEV_NAME=<your full name>             # split on first space for first/last name defaults
DEV_BARN=<barn-slug>                  # default barn slug for seed-account.sh
DEV_SUPABASE_URL=https://<your-dev-project-ref>.supabase.co  # must exactly match NEXT_PUBLIC_SUPABASE_URL — destructive scripts refuse to run otherwise
DEMO_USER_EMAIL=demo@stable-state.app # shared demo auth user, created by setup-demo-user.sh; /demo 404s without this set
DEMO_USER_PASSWORD=                   # leave empty — setup-demo-user.sh mints one and prints it to paste back here
DEMO_BARN_CAP=20                      # max concurrent demo barns before /demo reaps the oldest one; 0 = unlimited
CRON_SECRET=                          # leave empty until you paste your own; protects /api/cron/reset-demo, generate with `openssl rand -hex 32`
