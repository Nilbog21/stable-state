NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
DEV_EMAIL=<your-google-email>         # used by change-user.sh — must match the Google account you claim the seed invite with
DEV_NAME=<your full name>             # split on first space for first/last name defaults
DEV_BARN=<barn-slug>                  # default barn slug for seed-account.sh
DEV_SUPABASE_URL=https://<your-dev-project-ref>.supabase.co  # must exactly match NEXT_PUBLIC_SUPABASE_URL — destructive scripts refuse to run otherwise
