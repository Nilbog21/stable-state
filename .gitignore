# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# internal dev use
/specs
.claude/settings.local.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.swp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
test.log
# run-checklist-suite.sh's three logs: the run itself, and (#1601) the production build and the
# server it serves the suite from.
checklist-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
