{
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(git -C * show *)",
      "Bash(git -C * log *)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * diff *)",
      "Bash(bash scripts/check-coverage.sh *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/test-on-save.sh\""
          }
        ]
      }
    ]
  }
}
